# ChromaDB (dense search) — the fireguard-vector-store service
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=fire_safety_regulations

# Sparse index (SQLite FTS5) — shared data/ volume with fireguard-vector-store
SPARSE_DB_PATH=data/bm25.db

# Embedding model — MUST match fireguard-vector-store's model
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Retrieval tuning
DENSE_TOP_K=20
SPARSE_TOP_K=20
RRF_K=60

# Logging
LOG_LEVEL=INFO
